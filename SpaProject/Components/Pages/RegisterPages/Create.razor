@page "/registers/create"
@using Microsoft.EntityFrameworkCore
@using SpaProject.Models
@inject IDbContextFactory<SpaProject.Data.SpaProjectRegisterDB> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<style>
    /* Center register content in the viewport — matches login style */
    .auth-center {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 120px);
        padding: 1rem;
    }

    .auth-card {
        width: 100%;
        max-width: 420px;
        background: #fff;
        border-radius: 8px;
        padding: 1.25rem;
        box-shadow: 0 8px 20px rgba(0,0,0,0.06);
        border: 1px solid rgba(0,0,0,0.04);
    }

        .auth-card h2 {
            margin-bottom: .5rem;
            text-align: center;
        }

    .auth-footer {
        text-align: center;
        margin-top: .75rem;
    }
</style>

<div class="auth-center">
    <div class="auth-card">
        <h2>Register</h2>
        <hr />
        <EditForm method="post" Model="Register" OnValidSubmit="AddRegister" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="email" class="form-label">Email:</label>
                <InputText id="email" @bind-Value="Register.Email" class="form-control" aria-required="true" />
                <ValidationMessage For="() => Register.Email" class="text-danger" />
            </div>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="password" class="form-label">Password:</label>
                <InputText id="password" @bind-Value="Register.Password" class="form-control" aria-required="true" />
                <ValidationMessage For="() => Register.Password" class="text-danger" />
            </div>
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </EditForm>

        <div class="auth-footer mt-3">
            <a href="/Login">Already a member? Login</a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private Register Register { get; set; } = default!;

    protected override void OnInitialized() => Register ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddRegister()
    {
        using var context = DbFactory.CreateDbContext();
        context.Register.Add(Register);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/registers");
    }
}
