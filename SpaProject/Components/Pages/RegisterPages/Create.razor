@page "/registers/create"
@using Microsoft.EntityFrameworkCore
@using SpaProject.Models
@inject IDbContextFactory<SpaProject.Data.SpaProjectRegisterDB> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<style>
    /* Same background used on login for consistent look */
    .auth-bg {
        position: relative;
        background-image: url('/images/spa.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

    .auth-bg::before {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 1;
        pointer-events: none;
    }

    .auth-center {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        padding: 1rem;
    }

    .auth-card {
        width: 100%;
        max-width: 420px;
        background: rgba(255,255,255,0.98);
        border-radius: 8px;
        padding: 1.25rem;
        box-shadow: 0 8px 20px rgba(0,0,0,0.12);
        border: 1px solid rgba(0,0,0,0.06);
    }

    .auth-card h2 {
        margin-bottom: .5rem;
        text-align: center;
    }

    .auth-footer {
        text-align: center;
        margin-top: .75rem;
    }

    .form-text-info {
        font-size: 0.875rem;
        color: #6c757d;
        margin-top: 0.25rem;
    }
</style>

<div class="auth-bg">
    <div class="auth-center">
        <div class="auth-card">
            <h2>Register</h2>
            <hr />
            <EditForm method="post" Model="Register" OnValidSubmit="AddRegister" FormName="create" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="firstname" class="form-label">First Name:</label>
                    <InputText id="firstname" @bind-Value="Register.FirstName" class="form-control" aria-required="true" placeholder="John" />
                    <ValidationMessage For="() => Register.FirstName" class="text-danger" />
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="lastname" class="form-label">Last Name:</label>
                    <InputText id="lastname" @bind-Value="Register.LastName" class="form-control" aria-required="true" placeholder="Doe" />
                    <ValidationMessage For="() => Register.LastName" class="text-danger" />
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="phonenumber" class="form-label">Phone Number:</label>
                    <InputText id="phonenumber" @bind-Value="Register.PhoneNumber" class="form-control" type="tel" aria-required="true" placeholder="(123) 456-7890" />
                    <div class="form-text-info">Enter a valid phone number</div>
                    <ValidationMessage For="() => Register.PhoneNumber" class="text-danger" />
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="email" class="form-label">Email:</label>
                    <InputText id="email" @bind-Value="Register.Email" class="form-control" type="email" aria-required="true" placeholder="example@email.com" />
                    <div class="form-text-info">Enter a valid email address</div>
                    <ValidationMessage For="() => Register.Email" class="text-danger" />
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="password" class="form-label">Password:</label>
                    <InputText id="password" @bind-Value="Register.Password" class="form-control" type="password" aria-required="true" />
                    <div class="form-text-info">Password must be at least 6 characters</div>
                    <ValidationMessage For="() => Register.Password" class="text-danger" />
                </div>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Create Account</button>
                </div>
            </EditForm>

            <div class="auth-footer mt-3">
                <a href="/Login">Already a member? Login</a>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private Register Register { get; set; } = default!;

    protected override void OnInitialized() => Register ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddRegister()
    {
        using var context = DbFactory.CreateDbContext();
        
        // Auto-generate a unique CustomerId
        var maxCustomerId = await context.Register.AnyAsync() 
            ? await context.Register.MaxAsync(r => r.CustomerId) 
            : 0;
        Register.CustomerId = maxCustomerId + 1;
        
        context.Register.Add(Register);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/Login");
    }
}
