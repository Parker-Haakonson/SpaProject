@page "/Login"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using SpaProject.Data
@using SpaProject.Models
@inject IDbContextFactory<SpaProject.Data.SpaProjectRegisterDB> DbFactory
@inject NavigationManager Navigation

<style>
    /* Full-bleed background using wwwroot/images/spa.jpg with a dark overlay for contrast */
    .auth-bg {
        position: relative;
        background-image: url('/images/spa.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

    .auth-bg::before {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.5); /* adjust opacity if needed */
        z-index: 1;
        pointer-events: none;
    }

    /* Center login content on top of overlay */
    .login-center {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        max-width: 980px;
        padding: 1rem;
    }

    .login-card {
        width: 100%;
        max-width: 420px;
        background: rgba(255,255,255,0.98);
        border-radius: 8px;
        padding: 1.25rem;
        box-shadow: 0 8px 20px rgba(0,0,0,0.12);
        border: 1px solid rgba(0,0,0,0.06);
    }

    .login-card h2 {
        margin-bottom: .5rem;
        text-align: center;
    }

    .login-footer {
        text-align: center;
        margin-top: .75rem;
    }
</style>

<div class="auth-bg">
    <div class="login-center">
        <div class="login-card">
            <h2>Login</h2>
            <hr />
            <div>
                <input class="form-control mb-3" type="text" placeholder="Email" @bind="email" />
                <input class="form-control mb-3" type="password" placeholder="Password" @bind="password" />
                <div class="d-grid gap-2">
                    <button class="btn btn-primary" @onclick="clicked">Login</button>
                </div>
            </div>

            <div class="mt-3">
                @if (incorrect)
                {
                    <div class="alert alert-danger" role="alert">
                        Incorrect password or email entered.
                    </div>
                }
            </div>

            <div class="login-footer">
                <a href="registers/create">Not a member? Register here</a>
            </div>
        </div>
    </div>
</div>

@code {
    string message = "";
    bool incorrect = false;
    string email = "";
    string password = "";

    private record Credential(string Email, string Password, bool isAdmin, int id);

    private List<Credential>? Credentials;

    public void clicked()
    {
        foreach (var c in Credentials!)
        {
            if (c.Email.Equals(email))
            {
                if (c.Password.Equals(password))
                {
                    incorrect = false;
                    bool ia = c.isAdmin;
                    int id = c.id;
                    SetLoggedin(ia, id);
                    Navigation.NavigateTo("/");
                    return;
                }
                else
                {
                    incorrect = true;
                    return;
                }
            }
            else
            {
                incorrect = true;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Create a DbContext from the factory
        await using var ctx = await DbFactory.CreateDbContextAsync();

        // Replace `Register` with your actual entity type name if different.
        // This assumes there is an entity with `Email` and `Password` properties.
        Credentials = await ctx.Set<Register>()
                               .AsNoTracking()
                               .Select(r => new Credential(r.Email!, r.Password!, r.IsAdmin!, r.Id))
                               .ToListAsync();
    }
    public void SetLoggedin(bool ia, int id)
    {
        LogedIn.SetLogedIn(true);
        LogedIn.SetEmail(email);
        LogedIn.SetPassword(password);
        LogedIn.SetIsAdmin(ia);
        LogedIn.SetId(id);
    }

}
