@page "/Login"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using SpaProject.Data
@using SpaProject.Models
@inject IDbContextFactory<SpaProject.Data.SpaProjectRegisterDB> DbFactory
@inject NavigationManager Navigation

<style>
    /* Center login content in the viewport while preserving existing bootstrap classes */
    .login-center {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 120px); /* leaves room for header/sidebar */
        padding: 1rem;
    }

    .login-card {
        width: 100%;
        max-width: 420px;
        background: #fff;
        border-radius: 8px;
        padding: 1.25rem;
        box-shadow: 0 8px 20px rgba(0,0,0,0.06);
        border: 1px solid rgba(0,0,0,0.04);
    }

        .login-card h2 {
            margin-bottom: .5rem;
            text-align: center;
        }

    .login-footer {
        text-align: center;
        margin-top: .75rem;
    }
</style>

<div class="login-center">
    <div class="login-card">
        <h2>Login</h2>
        <hr />
        <div>
            <input class="form-control mb-3" type="text" placeholder="Email" @bind="email" />
            <input class="form-control mb-3" type="password" placeholder="Password" @bind="password" />
            <div class="d-grid gap-2">
                <button class="btn btn-primary" @onclick="clicked">Login</button>
            </div>
        </div>

        <div class="mt-3">
            @if (incorrect)
            {
                <div class="alert alert-danger" role="alert">
                    Incorrect password or email entered.
                </div>
            }
        </div>

        <div class="login-footer">
            <a href="registers/create">Not a member? Register here</a>
        </div>
    </div>
</div>

@code {
    string message = "";
    bool incorrect = false;
    string email = "";
    string password = "";

    private record Credential(string Email, string Password, bool isAdmin, int id);

    private List<Credential>? Credentials;

    public void clicked()
    {
        foreach (var c in Credentials!)
        {
            if (c.Email.Equals(email))
            {
                if (c.Password.Equals(password))
                {
                    incorrect = false;
                    bool ia = c.isAdmin;
                    int id = c.id;
                    SetLoggedin(ia, id);
                    Navigation.NavigateTo("/");
                    return;
                }
                else
                {
                    incorrect = true;
                    return;
                }
            }
            else
            {
                incorrect = true;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Create a DbContext from the factory
        await using var ctx = await DbFactory.CreateDbContextAsync();

        // Replace `Register` with your actual entity type name if different.
        // This assumes there is an entity with `Email` and `Password` properties.
        Credentials = await ctx.Set<Register>()
                               .AsNoTracking()
                               .Select(r => new Credential(r.Email!, r.Password!, r.IsAdmin!, r.Id))
                               .ToListAsync();
    }
    public void SetLoggedin(bool ia, int id)
    {
        LogedIn.SetLogedIn(true);
        LogedIn.SetEmail(email);
        LogedIn.SetPassword(password);
        LogedIn.SetIsAdmin(ia);
        LogedIn.SetId(id);
    }

}
