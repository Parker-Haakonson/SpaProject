@page "/service"
@using System.Collections.Generic
@rendermode InteractiveServer
@inject NavigationManager NavigationManager

<style>
    /* Page background using wwwroot/images/spa.jpg with a dark overlay for legibility */
    .services-bg {
        position: relative;
        background-image: url('/images/spa.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        padding: 3rem 1rem 4rem;
    }

    .services-bg::before {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.48); /* adjust opacity for more/less contrast */
        z-index: 1;
        pointer-events: none;
    }

    /* Keep original class names so other pages (Bookings tab, etc.) still work */
    .page-title {
        font-family: "Playfair Display", serif;
        font-size: 2rem;
        text-align: center;
        margin: 1.5rem 0;
        color: #24314a;
        letter-spacing: 0.2px;
    }

    /* when placed on the bg, make the heading readable */
    .services-bg .page-title {
        color: #ffffff;
        text-shadow: 0 2px 8px rgba(0,0,0,0.6);
        position: relative;
        z-index: 2;
    }

    .services-container {
        max-width: 1100px;
        margin: 0 auto 2.5rem;
        padding: 0 1rem;
        display: grid;
        gap: 1.25rem;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        position: relative;
        z-index: 2; /* bring cards above the overlay */
    }

    .service-card {
        background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
        border: 1px solid rgba(36,49,74,0.06);
        border-radius: 12px;
        padding: 1.25rem;
        box-shadow: 0 6px 18px rgba(36,49,74,0.06);
        transition: transform 160ms ease, box-shadow 160ms ease;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
    .service-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 30px rgba(36,49,74,0.10);
    }

    /* new: header layout for service card so image + text align nicely */
    .service-head {
        display: flex;
        align-items: center;
        gap: 0.875rem;
    }

    .service-image {
        width: 72px;
        height: 72px;
        object-fit: cover;
        border-radius: 8px;
        flex: 0 0 72px;
        border: 1px solid rgba(36,49,74,0.06);
    }

    .service-card h2 {
        margin: 0;
        color: #172033;
        font-size: 1.25rem;
    }

    .description {
        margin: 0.25rem 0 0.75rem;
        color: #475569;
        font-size: 0.95rem;
    }

    .pricing-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 0.5rem;
    }

    .pricing-table th,
    .pricing-table td {
        padding: 0.6rem 0.5rem;
        vertical-align: middle;
    }

    .pricing-table thead th {
        text-align: left;
        font-weight: 600;
        color: #556581;
        font-size: 0.85rem;
        padding-bottom: 0.6rem;
    }

    .pricing-table tbody tr + tr td {
        border-top: 1px solid rgba(36,49,74,0.06);
    }

    .price-badge {
        display: inline-block;
        background: linear-gradient(90deg, #f8fafc, #eef6ff);
        color: #0b2a66;
        padding: 0.25rem 0.5rem;
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.95rem;
        border: 1px solid rgba(11,42,102,0.06);
    }

    .duration-label {
        color: #334155;
        font-weight: 600;
    }

    .option-cell {
        text-align: right;
        width: 160px;
    }

    .btn-primary {
        min-width: 82px;
    }

    /* compact mobile appearance */
    .pricing-table thead {
        display: none;
    }
    .pricing-table tbody td {
        display: block;
        width: 100%;
    }
    .pricing-table tbody tr {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 0.5rem;
        padding: 0.5rem 0;
    }
</style>

<div class="services-bg">
    <h1 class="page-title">Our Massage Services</h1>

    <div class="services-container">
        @foreach (var service in Service)
        {
            <div class="service-card">
                <div class="service-head">
                    @if (service.Name == "Hot Stone Massage")
                    {
                        <img src="/images/hotStone.jpg" alt="Hot Stone Massage" class="service-image" />
                    }
                    else if (service.Name == "Full Body Massage")
                    {
                        <img src="/images/fullBody.jpg" alt="Full Body Massage" class="service-image" />
                    }
                    else if (service.Name == "Thai Massage")
                    {
                        <img src="/images/thaiMassage.jpg" alt="Thai Massage" class="service-image" />
                    }
                    else if (service.Name == "Sports Massage")
                    {
                        <img src="/images/sport.jpg" alt="Sports Massage" class="service-image" />
                    }
                    <div>
                        <h2 class="fw-bold">@service.Name</h2>
                        <p class="description fst-italic">@service.Description</p>
                    </div>
                </div>

                <table class="pricing-table" aria-label="@($"{service.Name} pricing options")">
                    <thead>
                        <tr>
                            <th>Duration</th>
                            <th class="option-cell">Action</th>
                            <th class="option-cell">Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div class="duration-label">30 Minutes</div>
                            </td>
                            <td class="option-cell">
                                <button class="btn btn-primary" @onclick="() => btnClick(service.Name, 30, service.Price30)" aria-label="@($"Book {service.Name} 30 minutes")">
                                    Book
                                </button>
                            </td>
                            <td class="option-cell">
                                <span class="price-badge">$@service.Price30</span>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <div class="duration-label">60 Minutes</div>
                            </td>
                            <td class="option-cell">
                                <button class="btn btn-primary" @onclick="() => btnClick(service.Name, 60, service.Price60)" aria-label="@($"Book {service.Name} 60 minutes")">
                                    Book
                                </button>
                            </td>
                            <td class="option-cell">
                                <span class="price-badge">$@service.Price60</span>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <div class="duration-label">90 Minutes</div>
                            </td>
                            <td class="option-cell">
                                <button class="btn btn-primary" @onclick="() => btnClick(service.Name, 90, service.Price90)" aria-label="@($"Book {service.Name} 90 minutes")">
                                    Book
                                </button>
                            </td>
                            <td class="option-cell">
                                <span class="price-badge">$@service.Price90</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    List<SpaService> Service = new()
    {
        new SpaService
        {
            Name = "Full Body Massage",
            Description = "A relaxing massage designed to relieve stress, improve circulation, and promote overall wellness.",
            Price30 = 50,
            Price60 = 90,
            Price90 = 130
        },
        new SpaService
        {
            Name = "Hot Stone Massage",
            Description = "Smooth, heated stones are used to ease muscle tension and enhance deep relaxation.",
            Price30 = 65,
            Price60 = 110,
            Price90 = 155
        },
        new SpaService
        {
            Name = "Thai Massage",
            Description = "A traditional therapy combining stretching, pressure points, and assisted yoga-like movements.",
            Price30 = 60,
            Price60 = 100,
            Price90 = 140
        },
        new SpaService
        {
            Name = "Sports Massage",
            Description = "Focused treatment to improve athletic performance, prevent injuries, and aid muscle recovery.",
            Price30 = 70,
            Price60 = 120,
            Price90 = 165
        }
    };

    // kept the same navigation logic and method name so bookings tab remains compatible
    public void btnClick(string serviceName, int duration, int price)
    {
        NavigationManager.NavigateTo($"/service/selected/{serviceName}/{duration}/{price}");
    }

    class SpaService
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public int Price30 { get; set; }
        public int Price60 { get; set; }
        public int Price90 { get; set; }
    }
}
